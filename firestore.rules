rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Datensatz gehört dem Aufrufer (bestehendes Dokument bzw. neue Daten)
    function ownsExisting() { return isSignedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return isSignedIn() && request.resource.data.userId == request.auth.uid; }

    // ── Analyse-Berichte ──────────────────────────────────────────────────────
    // Nur eigene Berichte. Lesen und Auflisten nur mit userId == eigene uid —
    // alle Abfragen der App filtern genau so (where('userId', '==', uid)).
    // Beim Anlegen muss userId die eigene uid sein, beim Ändern darf sie nicht
    // wechseln (z. B. Umbenennen über customName).
    match /reports/{reportId} {
      allow read:   if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // ── Video-Vergleiche ──────────────────────────────────────────────────────
    match /comparisons/{comparisonId} {
      allow read:   if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // ── Nutzerprofil ──────────────────────────────────────────────────────────
    // Nur der Eigentümer. Sprache, Onboarding, Profilbild, Anzeigename und der
    // Usage-Zähler (usageMonth/usageCount) bleiben voll schreibbar.
    // ABER: `isPro`, `hadProBefore`, `proExpiredAt` und `proOverride` sind
    // clientseitig NICHT setz- oder änderbar — das macht ausschließlich die
    // redeemAccessCode bzw. syncSubscriptionStatus Cloud Function über das
    // Admin SDK (proOverride nur manuell per Console). Wäre proOverride vom
    // Client schreibbar, könnte sich ein Nutzer damit vor dem Ablauf seines
    // Abos schützen und Pro dauerhaft behalten.
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId)
                    && ( !('isPro' in request.resource.data)
                         || request.resource.data.isPro == false )
                    && !('hadProBefore' in request.resource.data)
                    && !('proExpiredAt' in request.resource.data)
                    && !('proOverride' in request.resource.data);
      allow update: if isOwner(userId)
                    && !( 'isPro' in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( 'hadProBefore' in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( 'proExpiredAt' in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( 'proOverride' in request.resource.data.diff(resource.data).affectedKeys() );
      allow delete: if false;
    }

    // ── Zugangscodes ──────────────────────────────────────────────────────────
    // Kein Client-Zugriff (kein Lesen, kein Auflisten, kein Schreiben). Nur die
    // redeemAccessCode Cloud Function (Admin SDK) liest und markiert Codes.
    match /accessCodes/{code} {
      allow read, write: if false;
    }
  }
}
