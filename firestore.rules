rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Analysis reports — any signed-in user can read and write. Reports always
    // carry a userId field equal to request.auth.uid (set at save time), and
    // queries filter by it, so users only ever see their own reports.
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    // User profile documents (language, onboarding answers, etc.).
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Fallback: any other authenticated access is allowed.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
